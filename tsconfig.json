{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true, "isolatedModules": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "types": ["node"], "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
