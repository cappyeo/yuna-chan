# Copy to .env. Never commit real values. IDs are strings, not JavaScript numbers.
NODE_ENV=development
DISCORD_TOKEN=replace_me
DISCORD_APPLICATION_ID=replace_me
# Required, fail-closed allowlist: comma-separated server IDs.
DISCORD_GUILD_IDS=replace_me
DEFAULT_LOCALE=en
# Keep this password URL-safe (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=replace_me
APP_DATABASE_PASSWORD=replace_me
DATABASE_URL=postgresql://yuna:replace_me@127.0.0.1:5432/yuna
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3000
AUDIT_RETENTION_DAYS=90
LOG_LEVEL=info
